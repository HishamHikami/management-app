# Copy to .env (development) or /etc/orgmanager/env (production).
# Plain KEY=value lines, no quotes or spaces in values unless noted (read by systemd and the shell).

# Long random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Never 1 in production.
DEBUG=0

# Your domain(s), comma-separated.
ALLOWED_HOSTS=ksa-riyadh.halacreative.com
CSRF_TRUSTED_ORIGINS=https://ksa-riyadh.halacreative.com

TIME_ZONE=Asia/Riyadh

# Shown in the app. Keep the double quotes (values with spaces).
ORG_NAME="Karnataka Salafi Association – Riyadh Unit"
# Optional: shown on /privacy and /account-deletion.
ORG_CONTACT_EMAIL=
ORG_SHORT_NAME="KSA Riyadh Unit"

# Where the SQLite database and backups live.
DATA_DIR=/var/lib/orgmanager

# Where collectstatic puts CSS/JS for nginx to serve.
STATIC_ROOT=/srv/orgmanager/staticfiles

# --- Push notifications (optional) ---------------------------------------------------
# Path to the Firebase service-account JSON, e.g. /var/lib/orgmanager/firebase.json
# (owned by the app user, mode 600). See docs/PUSH.md.
# Leave empty to turn push off; the in-app inbox still works.
FIREBASE_CREDENTIALS=
# Public app settings (from google-services.json and GoogleService-Info.plist).
# Not secret: the app downloads them from /api/v1/config at start. Kept out of the repo anyway.
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_API_KEY=
