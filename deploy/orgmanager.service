# /etc/systemd/system/orgmanager.service
[Unit]
Description=Org Manager — committees app API (gunicorn)
After=network.target

[Service]
Type=notify
User=orgmanager
Group=www-data
# Read by systemd as root before dropping privileges, so it can be root:root 600.
EnvironmentFile=/etc/orgmanager/env
WorkingDirectory=/srv/orgmanager
ExecStart=/srv/orgmanager/.venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/orgmanager/gunicorn.sock \
    --umask 007 \
    --control-socket /run/orgmanager/gunicorn.ctl \
    --workers 1 --threads 4 --worker-class gthread \
    --max-requests 1000 --max-requests-jitter 100 \
    --timeout 60 \
    --access-logfile -
RuntimeDirectory=orgmanager
RuntimeDirectoryMode=0750
StateDirectory=orgmanager
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# The droplet has ~1 GB RAM shared with other apps: stay small.
MemoryHigh=150M
MemoryMax=250M

[Install]
WantedBy=multi-user.target
